# PromiseGraph Backend Environment Variables
APP_NAME=PromiseGraph API
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-bytes-min

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration (PostgreSQL)
# For local Docker: postgresql://postgres:postgres@localhost:5432/promisegraph
# For Docker Compose internal network: postgresql://postgres:postgres@db:5432/promisegraph
# For lightweight local development without Docker running: sqlite:///./promisegraph.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promisegraph
